# Group Accountability Discord Bot Configuration
# Copy this file to .env and configure your values.

# Discord Bot Token from Discord Developer Portal
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: Specific Guild ID for fast instant slash command registration during development
# Leave blank to register slash commands globally
GUILD_ID=

# Names of designated channels (bot will auto-create or match them)
TASKS_CHANNEL_NAME=tasks
DEADLINES_CHANNEL_NAME=deadlines
SUBMISSIONS_CHANNEL_NAME=submissions
WALL_OF_SHAME_CHANNEL_NAME=wall-of-shame

# SQLite Database File Path
DATABASE_PATH=bot_database.sqlite

# Timezone (e.g. UTC, America/New_York, Europe/London, Asia/Tokyo)
DEFAULT_TIMEZONE=UTC

# Voice / TTS Settings (espeak-ng)
TTS_ENABLED=true
TTS_ENGINE=espeak-ng
# Windows default: C:\Program Files\eSpeak NG\espeak-ng.exe
# Linux default: /usr/bin/espeak-ng
TTS_BINARY=
TTS_VOICE_DEFAULT=en-us
TTS_DELIVERY=attachment
